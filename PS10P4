def b_average (score1,score2,score3,handi):
    sum = score1 + score2 + score3
    average= (sum/3)
    haverage = (sum + handi) /3
    return average, haverage
lastname = str(input("Enter the last name of the bowler: "))
score1 = float(input("Enter the score of round one: "))
score2 = float(input("Enter the score of round two: "))
score3 = float(input("Enter the score of round three: "))
handi = float(input("Enter the handicap:"))
average, haverage = b_average(score1,score2,score3,handi)
print("Last name: ",lastname)
print("Your point average: ",average)
print("Your average with handicap: ", haverage)
