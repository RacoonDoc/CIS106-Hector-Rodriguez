# input phase
part_number = int(input("Part number: "))
quantity_of_parts = int(input("Quantity of parts: "))
# process phase
if part_number == 10 or part_number == 55:
    unit_price = 1.00
elif part_number == 99:
    unit_price = 2.00
elif part_number == 80 or part_number == 70:
    unit_price = 3.00
else:
    unit_price = 5.00
total_price =  quantity_of_parts * unit_price
# output phase
print("Part Number =", part_number)
print("Cost per part =", unit_price)
print("Total price =", total_price)
