# Input phase
number_of_books = int(input("Enter the number of books: "))
cost_per_book = float(input("Enter the cost per book: "))
# Process phase
subtotal = number_of_books * cost_per_book
if subtotal < 50.00:
    total = subtotal
else:
    total = subtotal + 25.00
# Output phase
print("Total Cost:", total)
